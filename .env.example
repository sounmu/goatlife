NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Participant token hashing. Generate a long random value.
TOKEN_PEPPER=replace-with-at-least-32-random-characters
PARTICIPANT_SESSION_DAYS=90
PARTICIPANT_TOKEN_DAYS=30

# Simple MVP admin login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Manual bank transfer details
BANK_NAME=국민은행
BANK_ACCOUNT=123456-12-123456
BANK_HOLDER=홍길동
